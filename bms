String get_api_url() { 
    if (cfg_server_region == 1) {
        return "https://api.libreview.io"; // US Server
    }
    return "https://api-eu.libreview.io"; // EU Server (Default)
}

String get_time(bool include_seconds) { 
    struct tm ti; 
    if(!getLocalTime(&ti)) return include_seconds ? "--:--:--" : "--:--"; 
    char b[16]; 
    strftime(b, sizeof(b), include_seconds ? "%H:%M:%S" : "%H:%M", &ti); 
    return String(b); 
}

void try_multi_wifi() {
    String ssids[] = {wifi_ssid, wifi_ssid2, wifi_ssid3}; 
    String passes[] = {wifi_password, wifi_password2, wifi_password3};
    int n = WiFi.scanNetworks();
    for (int i = 0; i < n; i++) {
        String available_ssid = WiFi.SSID(i);
        for (int j = 0; j < 3; j++) { 
            if (ssids[j] != "" && available_ssid == ssids[j]) { 
                WiFi.begin(ssids[j].c_str(), passes[j].c_str()); 
                int c = 0; 
                while (WiFi.status() != WL_CONNECTED && c++ < 20) delay(250); 
                if (WiFi.status() == WL_CONNECTED) return; 
            } 
        }
    }
}

