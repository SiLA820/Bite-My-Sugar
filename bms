void init_display_hard() { 
    Wire.begin(3, 4); Wire.setClock(100000); delay(150); 
    display.begin(SSD1306_SWITCHCAPVCC, 0x3C); 
    Wire.beginTransmission(0x3C); Wire.write(0x00); Wire.write(0xDA); Wire.write(0x12); Wire.endTransmission();
    display.clearDisplay(); display.display(); 
}

void update_display() {
    Wire.beginTransmission(0x3C); Wire.write(0x00); Wire.write(0xDA); Wire.write(0x12); Wire.endTransmission();
    display.clearDisplay(); display.invertDisplay(false); 
    String lt_min = get_time(false); int16_t x1, y1; uint16_t w, h_text;
    for(int i = 0; i < 16; i++) { display.drawFastHLine(0, i, 128, SSD1306_WHITE); }
    display.setTextColor(SSD1306_BLACK); display.setTextSize(2); 
    display.getTextBounds(lt_min, 0, 2, &x1, &y1, &w, &h_text); display.setCursor(64 - (w/2), 1); display.print(lt_min); 
    display.setTextColor(SSD1306_WHITE); 
    if (glucose_value == "AUTH_ERR" || glucose_value == "NO_MEAS" || glucose_value == "NO_DATA" || glucose_value == "HTML_BLK" || glucose_value == "JSON_ERR") {
        display.setTextSize(2); display.getTextBounds(glucose_value, 0, 32, &x1, &y1, &w, &h_text); display.setCursor(64 - (w/2), 32); display.print(glucose_value);
    } else {
        display.setTextSize(5); display.getTextBounds(glucose_value, 0, 22, &x1, &y1, &w, &h_text);
        int num_x = 12; display.setCursor(num_x, 22); display.print(glucose_value);
        display.setTextSize(2); display.setCursor(94, 24); display.print("mg"); display.setCursor(94, 42); display.print("dL");
    }
    display.display();
}
